{
  "name": "lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-strip-types --test src/core/*.test.ts",
    "test:e2e": "node scripts/e2e-test.mjs",
    "test:images": "node --experimental-strip-types scripts/test-images.mjs",
    "//test:scan-window": "Renders the native scan view and asserts the camera is visible only inside the scan window. Needs a running server (npm run serve).",
    "test:scan-window": "node scripts/preview-scan.mjs /tmp/labstock-scan.png && node scripts/check-scan-window.mjs /tmp/labstock-scan.png",
    "//test:scan-inventory": "Same check for the scan sheet opened from the Inventory page, which renders over another page.",
    "test:scan-inventory": "node scripts/preview-inventory-scan.mjs /tmp/labstock-inv-scan.png && node scripts/check-scan-window.mjs /tmp/labstock-inv-scan.png",
    "build:mobile": "node scripts/build-mobile.mjs",
    "sync": "npm run build:mobile && npm run cap:sync",
    "sync:android": "npm run build:mobile && cap sync android",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync:android && cap open android",
    "//cap:sync": "LANG/LC_ALL are required: CocoaPods crashes under a non-UTF-8 locale (Ruby Encoding::CompatibilityError).",
    "cap:sync": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 cap sync",
    "//serve": "A mobile build reuses .next as its working dir, so it leaves no API routes there. Rebuild the server target before serving.",
    "serve": "npm run build && npm start"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@prisma/client": "^6.19.3",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^3.0.3",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
